!.env.example
*.pem
*.pfx
*.key

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Superseded design bundle. The extracted design_handoff_it_ops_dashboard/ is the
# committed source of record; the archives are not tracked.
*.zip
