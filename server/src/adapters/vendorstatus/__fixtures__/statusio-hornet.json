    "maintenance": {
      "active": [
        {
          "_id": "6aaa9698ea433305b418fc0e",
          "datetime_planned_end": "2026-09-17T13:00:00.000Z",
          "datetime_planned_start": "2026-09-17T12:30:00.000Z",
          "name": "Hornet.email Security Maintanance",
          "datetime_open": "2026-09-16T13:16:08.950Z",
          "messages": [
            {
              "details": "At Hornetsecurity, we’re continually enhancing the security of the Hornet.email platform to keep pace with evolving best practices. As part of this ongoing work, we’re introducing a change that may affect some of your users’ accounts. \r\n\r\nUsers who regularly sign in to Hornet.email will not be affected - no action is needed for them. \r\n\r\nFor any of your users who haven’t logged into Hornet.email since April 28, 2026, their existing password will need to be reset the next time they try to access their account after September 17, 2026. \r\n\r\nWhat this means for your organisation:\r\n\r\n- Users who’ve signed in on or after April 28, 2026 are unaffected. \r\n- Users who haven’t logged in since April 28, 2026 will need a password reset the next time they access their account after September 17, 2026.\r\n - As a Control Panel administrator, you can perform this reset for any affected user whenever it’s needed. \r\n\r\nWe’re sharing this so you’re aware of the potential impact and can support any inactive users smoothly if and when they need access again. If you’d like to review which of your users may be affected, you can check sign-in activity in the Control Panel at any time.",
              "state": 100,
              "status": 200,
              "datetime": "2026-09-16T13:16:08.978Z"
            },
            {
              "details": "The maintenance has now started.",
              "state": 200,
              "status": 200,
              "datetime": "2026-09-17T12:45:09.257Z"
            },
            {
              "details": "Although the maintenance is complete, this status will remain visible for awareness until Monday, 21 September.",
              "state": 200,
              "status": 200,
              "datetime": "2026-09-18T11:06:05.385Z"
            }
          ],
